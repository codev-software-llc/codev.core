<?xml version="1.0"?>
<package >
  <metadata>
    <id>Codev.Core</id>
    <version>10.0.0</version>
    <authors>Codev Software, LLC</authors>
    <owners>Codev Software, LLC</owners>
    <language>en-US</language>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <title>Core Infrastructure</title>
    <description>Core Infrastructure repositories and services (Net 10.0)</description>
    <copyright>Copyright 2026</copyright>
    <icon>images\Codev_Logo.png</icon>
    <readme>docs\readme.md</readme>
    <dependencies>
      <group targetFramework="net10.0" />
    </dependencies>
  </metadata>
  <files>
    <file src="..\docs\readme.md" target="docs\" />
    <file src="..\images\Codev_Logo.png" target="images\" />
    <file src="..\bin\Infrastructure\dev\net10.0\*.dll" target="lib\net10.0" />
    <file src="..\bin\Infrastructure\dev\net10.0\*.pdb" target="lib\net10.0\symbols" />
    <file src="..\bin\Infrastructure\dev\net10.0\runtimes\win-x64\native\*"   target="runtimes\win-x64\native" />
    <file src="..\bin\Infrastructure\dev\net10.0\runtimes\linux-x64\native\*" target="runtimes\linux-x64\native" />
  </files>
</package>
